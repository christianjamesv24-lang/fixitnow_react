# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional comma-separated extra allowed origins for CORS/sockets
CORS_ORIGINS=
# lax (same-site) or none (cross-site frontend/API deployment; requires HTTPS)
COOKIE_SAMESITE=lax

# MySQL / MariaDB (XAMPP works too)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fixitnow
TEST_DB_NAME=fixitnow_test
# External managed MySQL requires TLS (Aiven, TiDB Cloud, PlanetScale, etc.)
DB_SSL=false
# Optional PEM CA certificate. Use \n for line breaks when stored as one env value.
DB_SSL_CA=

# Production admin bootstrap (set the password as a deployment secret).
ADMIN_EMAIL=
ADMIN_NAME=FixitNow Admin
ADMIN_PASSWORD=

# Auth (use long random strings)
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Web Push - generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@fixitnow.test

# Gmail password recovery
# Preferred: Google OAuth2 with a long-lived refresh token (scope: https://www.googleapis.com/auth/gmail.send)
# Create an OAuth client in Google Cloud Console, authorize it in OAuth 2.0 Playground
# with "Use your own OAuth credentials" enabled, then copy the refresh token here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Fallback: Gmail App Password (used automatically when the three OAuth values are empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=fixitnow.react@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM=fixitnow.react@gmail.com
# Production deployment (optional)
# Persistent upload directory (mount a volume here on your host)
UPLOADS_DIR=
# Built React app directory (defaults to ../client/dist)
CLIENT_DIST=
# Override cookie Secure flag (true/false). Leave blank to derive from CLIENT_URL/COOKIE_SAMESITE.
COOKIE_SECURE=
